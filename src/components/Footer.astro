---
// src/components/Footer.astro
const authorName = "Rafael Revi";
const authorEmail = "primers.flowing-0q@icloud.com";
const description = "Personal website and rants on software development.";
---

<footer class="site-footer">
  <div class="wrapper">
    <div class="footer-content">
      <div class="footer-col">
        <p class="feed-subscribe">
          <a class="subscribe-pill" href="/rss.xml">
            <svg class="svg-icon">
              <use xlink:href="/assets/minima-social-icons.svg#rss"></use>
            </svg>
            <span>Subscribe via RSS</span>
          </a>
        </p>
        <ul class="contact-list">
          <li class="p-name">{authorName}</li>
          <li><a class="u-email" href={`mailto:${authorEmail}`}>{authorEmail}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p>{description}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-content {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .footer-col {
    flex: 1 1 250px;
  }
  .subscribe-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 5px 14px;
    border-radius: 9999px;
    background-color: var(--pill-bg);
    border: 1.5px solid var(--pill-border);
    color: var(--text-color) !important;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none !important;
    transition: all 0.15s ease;
  }
  .subscribe-pill:hover {
    border-color: var(--compass-accent);
    color: var(--compass-accent) !important;
  }
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0 0;
    font-size: 0.875rem;
  }
  .contact-list li {
    margin-bottom: 0.25rem;
  }
</style>
