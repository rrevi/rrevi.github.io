---
// src/components/Header.astro
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  siteTitle?: string;
}

const { siteTitle = "Rants on Software Development" } = Astro.props;
---

<header class="site-header">
  <div class="wrapper">
    <a class="site-title" rel="author" href="/" title={siteTitle}>
      {siteTitle}
    </a>
    <nav class="site-nav" aria-label="Main Navigation">
      <!-- Desktop-Only Nav Pods (hidden on mobile) -->
      <a class="nav-item icon-nav nav-desktop-only" href="/about" title="About Rafael Revi" aria-label="About Rafael Revi">
        <svg class="svg-icon stroke-icon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>
      <a class="nav-item icon-nav nav-desktop-only" href="mailto:primers.flowing-0q@icloud.com" title="Email (primers.flowing-0q@icloud.com)" aria-label="Email Rafael Revi at primers.flowing-0q@icloud.com">
        <svg class="svg-icon stroke-icon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </a>
      <a class="nav-item icon-nav nav-desktop-only" rel="me" href="https://github.com/rrevi" title="GitHub (rrevi)" aria-label="GitHub profile: rrevi">
        <svg class="svg-icon" viewBox="0 0 16 16" aria-hidden="true">
          <use href="/assets/minima-social-icons.svg#github"></use>
        </svg>
      </a>
      <a class="nav-item icon-nav nav-desktop-only" rel="me" href="https://www.linkedin.com/in/rafaelrevi" title="LinkedIn (rafaelrevi)" aria-label="LinkedIn profile: rafaelrevi">
        <svg class="svg-icon" viewBox="0 0 16 16" aria-hidden="true">
          <use href="/assets/minima-social-icons.svg#linkedin"></use>
        </svg>
      </a>
      <a class="nav-item icon-nav nav-desktop-only" href="/rss.xml" title="Subscribe via RSS Feed" aria-label="Subscribe via RSS Feed">
        <svg class="svg-icon" viewBox="0 0 16 16" aria-hidden="true">
          <use href="/assets/minima-social-icons.svg#rss"></use>
        </svg>
      </a>

      <!-- Always visible Theme Toggle -->
      <ThemeToggle />

      <!-- Mobile Cockpit Hamburger Button (visible on mobile only) -->
      <button
        id="menu-toggle"
        class="nav-item icon-nav menu-toggle-btn"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        title="Toggle navigation menu"
      >
        <span class="menu-icon-bars" aria-hidden="true">
          <span class="bar bar-top"></span>
          <span class="bar bar-bottom"></span>
        </span>
      </button>
    </nav>
  </div>

  <!-- Mobile Cockpit Drawer (Slide-down menu on mobile) -->
  <div id="mobile-drawer" class="mobile-drawer" aria-label="Mobile Navigation" hidden>
    <div class="wrapper">
      <nav class="mobile-drawer-nav">
        <a class="drawer-about-card" href="/about">
          <div class="drawer-about-icon">
            <svg class="svg-icon stroke-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <div class="drawer-about-details">
            <span class="drawer-about-title">About Rafael Revi</span>
            <span class="drawer-about-subtext">Principal Applications Engineer &amp; Platform Lead</span>
          </div>
          <svg class="drawer-about-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>

        <div class="drawer-grid">
          <a class="drawer-grid-item" href="mailto:primers.flowing-0q@icloud.com" title="Email Rafael Revi">
            <svg class="svg-icon stroke-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>Email</span>
          </a>

          <a class="drawer-grid-item" rel="me" href="https://github.com/rrevi" title="GitHub (rrevi)">
            <svg class="svg-icon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
              <use href="/assets/minima-social-icons.svg#github"></use>
            </svg>
            <span>GitHub</span>
          </a>

          <a class="drawer-grid-item" rel="me" href="https://www.linkedin.com/in/rafaelrevi" title="LinkedIn (rafaelrevi)">
            <svg class="svg-icon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
              <use href="/assets/minima-social-icons.svg#linkedin"></use>
            </svg>
            <span>LinkedIn</span>
          </a>

          <a class="drawer-grid-item" href="/rss.xml" title="RSS Feed">
            <svg class="svg-icon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
              <use href="/assets/minima-social-icons.svg#rss"></use>
            </svg>
            <span>RSS Feed</span>
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  let menuAbortController: AbortController | null = null;

  function setupMobileMenu() {
    if (menuAbortController) {
      menuAbortController.abort();
      menuAbortController = null;
    }

    const toggleBtn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
    const drawer = document.getElementById('mobile-drawer') as HTMLElement | null;
    const header = document.querySelector('.site-header') as HTMLElement | null;

    if (!toggleBtn || !drawer || !header) return;

    const btn = toggleBtn;
    const panel = drawer;
    const host = header;
    const controller = new AbortController();
    menuAbortController = controller;
    const { signal } = controller;

    const isMenuOpen = () => btn.getAttribute('aria-expanded') === 'true';

    function openMenu() {
      panel.removeAttribute('hidden');
      // Force repaint before adding active class for transition
      void panel.offsetWidth;
      panel.classList.add('is-open');
      btn.classList.add('is-active');
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('title', 'Close navigation menu');
      btn.setAttribute('aria-label', 'Close navigation menu');
    }

    function closeMenu() {
      if (!isMenuOpen() && panel.hasAttribute('hidden')) return;
      panel.classList.remove('is-open');
      btn.classList.remove('is-active');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('title', 'Toggle navigation menu');
      btn.setAttribute('aria-label', 'Toggle navigation menu');
      setTimeout(() => {
        if (!panel.classList.contains('is-open')) {
          panel.setAttribute('hidden', '');
        }
      }, 200);
    }

    btn.addEventListener(
      'click',
      (e) => {
        e.stopPropagation();
        if (isMenuOpen()) {
          closeMenu();
        } else {
          openMenu();
        }
      },
      { signal }
    );

    // Close when clicking any nav link in drawer
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu, { signal });
    });

    // Close on outside click when open
    document.addEventListener(
      'click',
      (e) => {
        if (isMenuOpen() && !host.contains(e.target as Node)) {
          closeMenu();
        }
      },
      { signal }
    );

    // Close on Escape key
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && isMenuOpen()) {
          closeMenu();
          btn.focus();
        }
      },
      { signal }
    );
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
  document.addEventListener('astro:before-swap', () => {
    if (menuAbortController) {
      menuAbortController.abort();
      menuAbortController = null;
    }
    const drawer = document.getElementById('mobile-drawer');
    if (drawer) {
      drawer.classList.remove('is-open');
      drawer.setAttribute('hidden', '');
    }
  });
</script>
