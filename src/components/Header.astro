---
// src/components/Header.astro
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  siteTitle?: string;
}

const { siteTitle = "Rants on Software Development" } = Astro.props;
---

<header class="site-header">
  <div class="wrapper">
    <a class="site-title" rel="author" href="/">{siteTitle}</a>
    <nav class="site-nav" aria-label="Main Navigation">
      <a class="nav-item" href="/about">About</a>
      <a class="nav-item" rel="me" href="https://github.com/rrevi" title="rrevi" aria-label="GitHub profile">
        <svg class="svg-icon">
          <use xlink:href="/assets/minima-social-icons.svg#github"></use>
        </svg>
      </a>
      <a class="nav-item" rel="me" href="https://www.linkedin.com/in/rafaelrevi" title="rafaelrevi" aria-label="LinkedIn profile">
        <svg class="svg-icon">
          <use xlink:href="/assets/minima-social-icons.svg#linkedin"></use>
        </svg>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
