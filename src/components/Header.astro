---
// src/components/Header.astro
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  siteTitle?: string;
}

const { siteTitle = "Rants on Software Development" } = Astro.props;
---

<header class="site-header">
  <div class="wrapper">
    <a class="site-title" rel="author" href="/" title={siteTitle}>
      {siteTitle}
    </a>
    <nav class="site-nav" aria-label="Main Navigation">
      <a class="nav-item icon-nav" href="/about" title="About Rafael Revi" aria-label="About Rafael Revi">
        <svg class="svg-icon stroke-icon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>
      <a class="nav-item icon-nav" href="mailto:primers.flowing-0q@icloud.com" title="Email (primers.flowing-0q@icloud.com)" aria-label="Email Rafael Revi at primers.flowing-0q@icloud.com">
        <svg class="svg-icon stroke-icon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </a>
      <a class="nav-item icon-nav" rel="me" href="https://github.com/rrevi" title="GitHub (rrevi)" aria-label="GitHub profile: rrevi">
        <svg class="svg-icon">
          <use href="/assets/minima-social-icons.svg#github"></use>
        </svg>
      </a>
      <a class="nav-item icon-nav" rel="me" href="https://www.linkedin.com/in/rafaelrevi" title="LinkedIn (rafaelrevi)" aria-label="LinkedIn profile: rafaelrevi">
        <svg class="svg-icon">
          <use href="/assets/minima-social-icons.svg#linkedin"></use>
        </svg>
      </a>
      <a class="nav-item icon-nav" href="/rss.xml" title="Subscribe via RSS Feed" aria-label="Subscribe via RSS Feed">
        <svg class="svg-icon">
          <use href="/assets/minima-social-icons.svg#rss"></use>
        </svg>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
