---
// src/components/Header.astro
import ThemeToggle from './ThemeToggle.astro';
import HomeIcon from '../assets/icons/home.svg';
import UserIcon from '../assets/icons/user.svg';
import MailIcon from '../assets/icons/mail.svg';
import GithubIcon from '../assets/icons/github.svg';
import LinkedinIcon from '../assets/icons/linkedin.svg';
import RssIcon from '../assets/icons/rss.svg';
import ChevronRightIcon from '../assets/icons/chevron-right.svg';

const path = Astro.url.pathname.replace(/\/$/, '');
const isHome = path === '';
const isAbout = path === '/about';
---

<header class="site-header">
  <div class="wrapper">
    <a class="nav-item" href="/" title="Home" aria-label="Home" aria-current={isHome ? 'page' : undefined}>
      <HomeIcon class="svg-icon stroke-icon" aria-hidden="true" />
    </a>
    <nav class="site-nav" aria-label="Main Navigation">
      <!-- Desktop-Only Nav Pods (hidden on mobile) -->
      <a class="nav-item icon-nav nav-desktop-only" href="/about" title="About" aria-label="About" aria-current={isAbout ? 'page' : undefined}>
        <UserIcon class="svg-icon stroke-icon" width={17} height={17} aria-hidden="true" />
      </a>
      <a class="nav-item icon-nav nav-desktop-only" href="mailto:primers.flowing-0q@icloud.com" title="Email" aria-label="Email">
        <MailIcon class="svg-icon stroke-icon" width={17} height={17} aria-hidden="true" />
      </a>
      <a class="nav-item icon-nav nav-desktop-only" rel="me" href="https://github.com/rrevi" title="GitHub (rrevi)" aria-label="GitHub profile: rrevi">
        <GithubIcon class="svg-icon" width={16} height={16} aria-hidden="true" />
      </a>
      <a class="nav-item icon-nav nav-desktop-only" rel="me" href="https://www.linkedin.com/in/rafaelrevi" title="LinkedIn (rafaelrevi)" aria-label="LinkedIn profile: rafaelrevi">
        <LinkedinIcon class="svg-icon" width={16} height={16} aria-hidden="true" />
      </a>
      <a class="nav-item icon-nav nav-desktop-only" href="/rss.xml" title="Subscribe via RSS Feed" aria-label="Subscribe via RSS Feed">
        <RssIcon class="svg-icon" width={16} height={16} aria-hidden="true" />
      </a>

      <!-- Always visible Theme Toggle -->
      <ThemeToggle />

      <!-- Mobile Cockpit Hamburger Button (visible on mobile only) -->
      <button
        id="menu-toggle"
        class="nav-item icon-nav menu-toggle-btn"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        title="Toggle navigation menu"
        hidden
      >
        <span class="menu-icon-bars" aria-hidden="true">
          <span class="bar bar-top"></span>
          <span class="bar bar-bottom"></span>
        </span>
      </button>
    </nav>
  </div>

  <!-- Mobile Cockpit Drawer (Slide-down menu on mobile) -->
  <div id="mobile-drawer" class="mobile-drawer">
    <div class="wrapper">
      <nav class="mobile-drawer-nav" aria-label="Mobile Navigation">
        <a class="drawer-about-card" href="/about" aria-current={isAbout ? 'page' : undefined}>
          <div class="drawer-about-icon">
            <UserIcon class="svg-icon stroke-icon" width={18} height={18} aria-hidden="true" />
          </div>
          <span class="drawer-about-title">About</span>
          <ChevronRightIcon class="drawer-about-chevron" width={16} height={16} aria-hidden="true" />
        </a>

        <div class="drawer-grid">
          <a class="drawer-grid-item" href="mailto:primers.flowing-0q@icloud.com" title="Email">
            <MailIcon class="svg-icon stroke-icon" width={16} height={16} aria-hidden="true" />
            <span>Email</span>
          </a>

          <a class="drawer-grid-item" rel="me" href="https://github.com/rrevi" title="GitHub (rrevi)">
            <GithubIcon class="svg-icon" width={15} height={15} aria-hidden="true" />
            <span>GitHub</span>
          </a>

          <a class="drawer-grid-item" rel="me" href="https://www.linkedin.com/in/rafaelrevi" title="LinkedIn (rafaelrevi)">
            <LinkedinIcon class="svg-icon" width={15} height={15} aria-hidden="true" />
            <span>LinkedIn</span>
          </a>

          <a class="drawer-grid-item" href="/rss.xml" title="RSS Feed">
            <RssIcon class="svg-icon" width={15} height={15} aria-hidden="true" />
            <span>RSS Feed</span>
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  let menuAbortController: AbortController | null = null;

  function setupMobileMenu() {
    if (menuAbortController) {
      menuAbortController.abort();
      menuAbortController = null;
    }

    const btn = document.querySelector<HTMLButtonElement>('#menu-toggle');
    const panel = document.getElementById('mobile-drawer');
    const host = document.querySelector('.site-header');

    if (!btn || !panel || !host) return;
    const controller = new AbortController();
    menuAbortController = controller;
    const { signal } = controller;

    const mobileViewport = window.matchMedia('(width < 640px)');
    const isMenuOpen = () => btn.getAttribute('aria-expanded') === 'true';

    const setMenuOpen = (open: boolean) => {
      if (!open && panel.contains(document.activeElement)) {
        btn.focus({ preventScroll: true });
      }
      panel.inert = !open;
      panel.classList.toggle('is-open', open);
      btn.classList.toggle('is-active', open);
      btn.setAttribute('aria-expanded', String(open));
      const label = open ? 'Close navigation menu' : 'Open navigation menu';
      btn.setAttribute('title', label);
      btn.setAttribute('aria-label', label);
    };

    btn.addEventListener(
      'click',
      () => setMenuOpen(!isMenuOpen()),
      { signal }
    );

    mobileViewport.addEventListener('change', () => setMenuOpen(false), { signal });

    // Close when clicking any nav link in drawer
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false), { signal });
    });

    // Close on outside click when open
    document.addEventListener(
      'click',
      (e) => {
        if (isMenuOpen() && !host.contains(e.target as Node)) {
          setMenuOpen(false);
        }
      },
      { signal }
    );

    // Close on Escape key
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && isMenuOpen()) {
          btn.focus({ preventScroll: true });
          setMenuOpen(false);
        }
      },
      { signal }
    );

    document.addEventListener('astro:before-swap', () => {
      panel.hidden = true;
      controller.abort();
    }, { once: true, signal });

    setMenuOpen(false);
    host.classList.add('menu-enhanced');
    btn.hidden = false;
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
