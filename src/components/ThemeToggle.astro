---
// src/components/ThemeToggle.astro
import SunIcon from '../assets/icons/sun.svg';
import MoonIcon from '../assets/icons/moon.svg';
---

<button id="theme-toggle" class="nav-item theme-toggle-btn" type="button" aria-label="Toggle light or dark theme" title="Toggle light or dark theme">
  <SunIcon class="svg-icon sun-icon" width={16} height={16} aria-hidden="true" />
  <MoonIcon class="svg-icon moon-icon" width={16} height={16} aria-hidden="true" />
</button>

<script>
  function setupThemeToggle() {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle) return;

    function getEffectiveTheme(): string {
      const explicit = document.documentElement.getAttribute('data-theme');
      if (explicit) return explicit;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function updateTooltip(theme: string) {
      if (!toggle) return;
      const nextTheme = theme === 'dark' ? 'light' : 'dark';
      const label = `Switch to ${nextTheme} theme`;
      toggle.setAttribute('title', label);
      toggle.setAttribute('aria-label', label);
    }

    updateTooltip(getEffectiveTheme());

    toggle.addEventListener('click', () => {
      const current = getEffectiveTheme();
      const nextTheme = current === 'dark' ? 'light' : 'dark';

      document.documentElement.setAttribute('data-theme', nextTheme);
      localStorage.setItem('theme', nextTheme);
      updateTooltip(nextTheme);
    });
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
