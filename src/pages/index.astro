---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPost, formatDate } from '../utils/posts';

const rawPosts = await getCollection('blog', ({ data }) => {
  return data.published !== false;
});

const posts = rawPosts
  .map(formatPost)
  .sort((a, b) => b.date.getTime() - a.date.getTime());

// Group posts by year
const postsByYear: Record<number, typeof posts> = {};
for (const post of posts) {
  if (!postsByYear[post.year]) {
    postsByYear[post.year] = [];
  }
  postsByYear[post.year].push(post);
}

const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout>
  <div class="post-feed">
    {years.map((year) => (
      <section class="year-section">
        <div class="year-marker">{year}</div>
        <div class="post-item-group">
          {postsByYear[year].map((post) => (
            <a class="post-item" href={`/${post.slug}`}>
              <h2 class="post-item-title">{post.title}</h2>
              <div class="post-item-meta">
                <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
                <span class="bullet">•</span>
                <span>{post.readingTime}</span>
              </div>
              {post.intro && <p class="post-item-intro">{post.intro}</p>}
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
