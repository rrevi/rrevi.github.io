---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPost, formatDate } from '../utils/posts';

const rawPosts = await getCollection('blog', ({ data }) => {
  return data.published !== false;
});

const posts = rawPosts
  .map(formatPost)
  .sort((a, b) => b.date.getTime() - a.date.getTime());

// Group posts by year
const postsByYear: Record<number, typeof posts> = {};
for (const post of posts) {
  if (!postsByYear[post.year]) {
    postsByYear[post.year] = [];
  }
  postsByYear[post.year].push(post);
}

const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout>
  <div class="home">
    {years.map((year) => (
      <section class="year-group">
        <h3 class="post-year-heading">{year}</h3>
        <table class="post-list">
          <tbody>
            {postsByYear[year].map((post) => (
              <tr>
                <td>
                  <span>{formatDate(post.date)}</span>
                </td>
                <td>
                  <a href={`/${post.slug}`}>{post.title}</a>
                  {post.intro && (
                    <span class="post-intro">
                      <br />
                      {post.intro}
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}
  </div>
</BaseLayout>
