---
// src/pages/[...slug].astro
import { render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { getPublishedPosts } from '../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post, index) => {
    const nextPost = index > 0 ? posts[index - 1] : undefined; // Newer post
    const prevPost = index < posts.length - 1 ? posts[index + 1] : undefined; // Older post

    return {
      params: { slug: post.slug },
      props: { post, prevPost, nextPost },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post.entry);
---

<PostLayout post={post} headings={headings} prevPost={prevPost} nextPost={nextPost}>
  <Content />
</PostLayout>
