---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404: Page not found">
  <div class="page-not-found">
    <div class="stadium-pill alert-pill">
      <span>404</span>
    </div>
    <h1 class="not-found-title">Page not found</h1>
    <p class="not-found-lead">
      This page may have moved, or the link may be out of date.
    </p>
    <p>
      <a href="/" class="back-link">
        &larr; All Posts
      </a>
    </p>
  </div>
</BaseLayout>

<style>
  .page-not-found {
    text-align: center;
    padding: 4.5rem 1rem 3rem 1rem;
  }

  .alert-pill {
    margin-bottom: 1.25rem;
  }

  .not-found-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: var(--compass-accent);
    letter-spacing: -0.03em;
  }

  .not-found-lead {
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto 2.25rem auto;
    font-size: 1.05rem;
    line-height: 1.6;
  }

</style>
