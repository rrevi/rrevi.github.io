---
// src/layouts/PostLayout.astro
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/posts';
import type { FormattedPost } from '../utils/posts';

interface Props {
  post: FormattedPost;
  prevPost?: FormattedPost;
  nextPost?: FormattedPost;
}

const { post, prevPost, nextPost } = Astro.props;
---

<BaseLayout title={post.title} description={post.intro || post.title}>
  <!-- Rivian Telemetry Reading Progress Bar -->
  <div id="scroll-progress" class="scroll-progress-bar"></div>

  <!-- Mobile Floating Thumb-Zone Action Pill -->
  <aside id="mobile-thumb-pill" class="mobile-thumb-pill" aria-label="Reading Controls">
    <button id="thumb-back-to-top" class="thumb-pill-btn" type="button" aria-label="Scroll to top of article">
      <svg class="thumb-arrow-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="12" y1="19" x2="12" y2="5"></line>
        <polyline points="5 12 12 5 19 12"></polyline>
      </svg>
      <span>TOP</span>
    </button>
    <div class="thumb-pill-divider"></div>
    <div id="thumb-progress-pct" class="thumb-pill-pct">0%</div>
  </aside>

  <article class="post">
    <!-- Waypoint Back Bar -->
    <div class="post-back-bar">
      <a class="back-link" href="/" title="Back to All Posts" aria-label="Back to All Posts">
        <svg class="svg-icon stroke-icon back-arrow" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>All Posts</span>
      </a>
    </div>

    <header class="article-header">
      <div class="article-meta-row">
        <div class="stadium-pill">
          <span>{formatDate(post.date, 'full')}</span>
          <span class="pill-dot"></span>
          <span>{post.readingTime}</span>
        </div>
      </div>
      <h1 class="article-title">{post.title}</h1>
      {post.intro && <p class="article-lead">{post.intro}</p>}
    </header>

    <div class="post-content">
      <slot />
    </div>

    <!-- Article Author Signoff -->
    <footer class="article-footer">
      <div class="article-author-card">
        <div class="author-avatar">
          <svg class="svg-icon stroke-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <div class="author-details">
          <span class="author-name">Rafael Revi</span>
          <span class="author-subtext">Principal Applications Engineer &amp; Platform Lead &bull; <a href="/about" class="author-link">View experience &rarr;</a></span>
        </div>
      </div>
    </footer>

    <!-- Bottom Chronology Post Navigation -->
    {(prevPost || nextPost) && (
      <nav class="post-navigation" aria-label="Post Navigation">
        {prevPost && (
          <a class="prev-post" href={`/${prevPost.slug}`} title={prevPost.title}>
            <span class="nav-label">
              <svg class="nav-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              <span>PREVIOUS POST</span>
            </span>
            <span class="nav-title">{prevPost.title}</span>
          </a>
        )}
        {nextPost && (
          <a class="next-post" href={`/${nextPost.slug}`} title={nextPost.title}>
            <span class="nav-label">
              <span>NEXT POST</span>
              <svg class="nav-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
            <span class="nav-title">{nextPost.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>

  <script>
    let scrollCleanup: (() => void) | null = null;

    function setupScrollControls() {
      if (scrollCleanup) {
        scrollCleanup();
        scrollCleanup = null;
      }

      const bar = document.getElementById('scroll-progress');
      const thumbPill = document.getElementById('mobile-thumb-pill');
      const thumbPct = document.getElementById('thumb-progress-pct');
      const topBtn = document.getElementById('thumb-back-to-top');

      if (!bar && !thumbPill) return;

      if (topBtn) {
        topBtn.onclick = () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        };
      }

      function update() {
        const docEl = document.documentElement;
        const scrollTop = window.scrollY || docEl.scrollTop;
        const scrollHeight = docEl.scrollHeight - docEl.clientHeight;
        const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        const pctClamped = Math.min(100, Math.max(0, Math.round(progress)));

        if (bar) {
          bar.style.width = `${pctClamped}%`;
        }

        if (thumbPill && thumbPct) {
          thumbPct.textContent = `${pctClamped}%`;
          if (scrollTop > 260 && pctClamped < 98) {
            thumbPill.classList.add('visible');
          } else {
            thumbPill.classList.remove('visible');
          }
        }
      }

      window.addEventListener('scroll', update, { passive: true });
      update();

      scrollCleanup = () => {
        window.removeEventListener('scroll', update);
      };
    }

    setupScrollControls();
    document.addEventListener('astro:after-swap', setupScrollControls);
    document.addEventListener('astro:before-swap', () => {
      if (scrollCleanup) {
        scrollCleanup();
        scrollCleanup = null;
      }
    });
  </script>
</BaseLayout>
