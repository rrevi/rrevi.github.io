---
// src/layouts/PostLayout.astro
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ArrowLeftIcon from '../assets/icons/arrow-left.svg';
import ArrowRightIcon from '../assets/icons/arrow-right.svg';
import ArrowUpIcon from '../assets/icons/arrow-up.svg';
import UserIcon from '../assets/icons/user.svg';
import { formatDate } from '../utils/posts';
import type { FormattedPost } from '../utils/posts';

interface Props {
  post: FormattedPost;
  headings?: MarkdownHeading[];
  prevPost?: FormattedPost;
  nextPost?: FormattedPost;
}

const { post, headings = [], prevPost, nextPost } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const baseDepth = tocHeadings.length > 0 ? Math.min(...tocHeadings.map((h) => h.depth)) : 2;
---

<BaseLayout
  title={post.title}
  description={post.intro || post.title}
  type="article"
  publishedTime={post.date}
  ogImage={`/og/${post.slug}.png`}
>
  <!-- Rivian Telemetry Reading Progress Bar -->
  <div id="scroll-progress" class="scroll-progress-bar"></div>

  <!-- Mobile Floating Thumb-Zone Action Pill -->
  <aside id="mobile-thumb-pill" class="mobile-thumb-pill" aria-label="Reading Controls">
    <button id="thumb-back-to-top" class="thumb-pill-btn" type="button" aria-label="Scroll to top of article">
      <ArrowUpIcon class="thumb-arrow-icon" width={13} height={13} aria-hidden="true" />
      <span>TOP</span>
    </button>
    <div class="thumb-pill-divider"></div>
    <div id="thumb-progress-pct" class="thumb-pill-pct">0%</div>
  </aside>

  <article class="post">
    <!-- Waypoint Back Bar -->
    <div class="post-back-bar">
      <a class="back-link" href="/" title="Back to All Posts" aria-label="Back to All Posts">
        <ArrowLeftIcon class="svg-icon stroke-icon back-arrow" width={15} height={15} aria-hidden="true" />
        <span>All Posts</span>
      </a>
    </div>

    <header class="article-header">
      <div class="article-meta-row">
        <div class="stadium-pill">
          <span>{formatDate(post.date, 'full')}</span>
          <span class="pill-dot"></span>
          <span>{post.readingTime}</span>
        </div>
      </div>
      <h1 class="article-title" transition:name={`post-title-${post.slug}`}>{post.title}</h1>
      {post.intro && <p class="article-lead">{post.intro}</p>}
    </header>

    {tocHeadings.length >= 3 && (
      <details class="post-toc">
        <summary class="post-toc-summary">
          <span class="post-toc-dot" aria-hidden="true"></span>
          <span class="post-toc-label">ON THIS PAGE ({tocHeadings.length})</span>
        </summary>
        <nav class="post-toc-nav" aria-label="Table of Contents">
          <ol class="post-toc-list">
            {tocHeadings.map((heading) => (
              <li class="post-toc-item" style={`--toc-indent: ${Math.max(0, heading.depth - baseDepth)}`}>
                <a class="post-toc-link" href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    )}

    <div class="post-content">
      <slot />
    </div>

    <!-- Article Author Signoff -->
    <footer class="article-footer">
      <div class="article-author-card">
        <div class="author-avatar">
          <UserIcon class="svg-icon stroke-icon" width={18} height={18} aria-hidden="true" />
        </div>
        <div class="author-details">
          <span class="author-name">Rafael Revi</span>
          <span class="author-subtext">Principal Applications Engineer &amp; Platform Lead &bull; <a href="/about" class="author-link">View experience &rarr;</a></span>
        </div>
      </div>
    </footer>

    <!-- Bottom Chronology Post Navigation -->
    {(prevPost || nextPost) && (
      <nav class="post-navigation" aria-label="Post Navigation">
        {prevPost && (
          <a class="prev-post" href={`/${prevPost.slug}`} title={prevPost.title}>
            <span class="nav-label">
              <ArrowLeftIcon class="svg-icon stroke-icon nav-arrow" width={14} height={14} aria-hidden="true" />
              <span>PREVIOUS POST</span>
            </span>
            <span class="nav-title">{prevPost.title}</span>
          </a>
        )}
        {nextPost && (
          <a class="next-post" href={`/${nextPost.slug}`} title={nextPost.title}>
            <span class="nav-label">
              <span>NEXT POST</span>
              <ArrowRightIcon class="svg-icon stroke-icon nav-arrow" width={14} height={14} aria-hidden="true" />
            </span>
            <span class="nav-title">{nextPost.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>

  <script>
    let scrollCleanup: (() => void) | null = null;
    const copyResetTimers = new WeakMap<HTMLElement, number>();

    function setupScrollControls() {
      if (scrollCleanup) {
        scrollCleanup();
        scrollCleanup = null;
      }

      const bar = document.getElementById('scroll-progress');
      const thumbPill = document.getElementById('mobile-thumb-pill');
      const thumbPct = document.getElementById('thumb-progress-pct');
      const topBtn = document.getElementById('thumb-back-to-top');

      if (!bar && !thumbPill) return;

      if (topBtn) {
        topBtn.onclick = () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        };
      }

      function update() {
        const docEl = document.documentElement;
        const scrollTop = window.scrollY || docEl.scrollTop;
        const scrollHeight = docEl.scrollHeight - docEl.clientHeight;
        const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        const pctClamped = Math.min(100, Math.max(0, Math.round(progress)));

        if (bar) {
          bar.style.width = `${pctClamped}%`;
        }

        if (thumbPill && thumbPct) {
          thumbPct.textContent = `${pctClamped}%`;
          if (scrollTop > 260 && pctClamped < 98) {
            thumbPill.classList.add('visible');
          } else {
            thumbPill.classList.remove('visible');
          }
        }
      }

      window.addEventListener('scroll', update, { passive: true });
      update();

      scrollCleanup = () => {
        window.removeEventListener('scroll', update);
      };
    }

    async function handleCopyClick(event: MouseEvent) {
      const target = event.target as HTMLElement | null;
      const copyBtn = target?.closest<HTMLButtonElement>('.copy-code-button');
      if (!copyBtn) return;

      const wrapper = copyBtn.closest('.code-block-wrapper');
      const block = wrapper?.querySelector<HTMLElement>('pre.astro-code');
      if (!block) return;

      const codeEl = block.querySelector('code');
      const code = codeEl ? codeEl.innerText : block.innerText;

      try {
        await navigator.clipboard.writeText(code);
        copyBtn.classList.add('copied');
        const copyIcon = copyBtn.querySelector<HTMLElement>('.copy-icon');
        const checkIcon = copyBtn.querySelector<HTMLElement>('.check-icon');
        const copyText = copyBtn.querySelector<HTMLElement>('.copy-text');
        if (copyIcon) copyIcon.style.display = 'none';
        if (checkIcon) checkIcon.style.display = 'inline-block';
        if (copyText) copyText.innerText = 'Copied!';

        const existingTimer = copyResetTimers.get(copyBtn);
        if (existingTimer) window.clearTimeout(existingTimer);

        const timer = window.setTimeout(() => {
          copyBtn.classList.remove('copied');
          if (copyIcon) copyIcon.style.display = 'inline-block';
          if (checkIcon) checkIcon.style.display = 'none';
          if (copyText) copyText.innerText = 'Copy';
          copyResetTimers.delete(copyBtn);
        }, 2000);
        copyResetTimers.set(copyBtn, timer);
      } catch (err) {
        console.error('Failed to copy code: ', err);
      }
    }

    setupScrollControls();
    document.addEventListener('click', handleCopyClick);
    document.addEventListener('astro:after-swap', setupScrollControls);
    document.addEventListener('astro:before-swap', () => {
      if (scrollCleanup) {
        scrollCleanup();
        scrollCleanup = null;
      }
    });
  </script>
</BaseLayout>

<style>
  .post-toc {
    max-width: 680px;
    margin-bottom: 1.5rem;
    padding: 0.6rem 0.9rem;
    background-color: var(--surface);
    border: 1.5px solid var(--border-color);
    border-radius: 10px;
  }

  .post-toc-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    font-family: "Geist Mono", monospace;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    user-select: none;
  }

  .post-toc-summary::-webkit-details-marker {
    display: none;
  }

  .post-toc-summary::after {
    content: '+';
    margin-left: auto;
    font-size: 0.95rem;
    line-height: 1;
    color: var(--compass-accent);
  }

  .post-toc[open] .post-toc-summary::after {
    content: '−';
  }

  .post-toc-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--compass-accent);
    flex-shrink: 0;
  }

  .post-toc-nav {
    margin-top: 0.65rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border-color);
  }

  .post-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .post-toc-item {
    padding-left: calc(var(--toc-indent, 0) * 0.95rem);
  }

  .post-toc-link {
    display: inline-block;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--text-color);
  }

  .post-toc-link:hover,
  .post-toc-link:focus-visible {
    color: var(--compass-accent);
  }

  :global(.post-content h2),
  :global(.post-content h3),
  :global(.post-content h4) {
    scroll-margin-top: calc(var(--site-header-row-height) + env(safe-area-inset-top) + 1rem);
  }

  :global(.post-content .heading-anchor) {
    display: inline-flex;
    align-items: center;
    margin-left: 0.4rem;
    vertical-align: middle;
    color: var(--text-muted);
    opacity: 0.35;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  @media (hover: hover) {
    :global(.post-content .heading-anchor) {
      opacity: 0;
    }
  }

  :global(.post-content h2:hover .heading-anchor),
  :global(.post-content h3:hover .heading-anchor),
  :global(.post-content h4:hover .heading-anchor),
  :global(.post-content .heading-anchor:focus-visible) {
    opacity: 1;
    color: var(--compass-accent);
  }
</style>
